# Apache / LiteSpeed (Hostinger): upload with the complete build directory.
# Keep the existing www canonical host used by the live site's metadata.
Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.scorpiongolfcarts\.com$ [NC]
RewriteRule ^ https://www.scorpiongolfcarts.com%{REQUEST_URI} [R=301,L,NE]

# Redirect explicit index documents and slash variants to one public URL.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NE]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

# Serve generated pages directly, with no directory/slash redirect cycle.
# AI agents that ask for Markdown get the generated index.md (no HTML parsing).
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteRule ^$ index.md [END]
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteRule ^(cars|about|contact|san-pedro-golf-cart-rental-guide|things-to-do-in-san-pedro-by-golf-cart|rental-terms|privacy)$ $1/index.md [END]
RewriteRule ^(cars|about|contact|san-pedro-golf-cart-rental-guide|things-to-do-in-san-pedro-by-golf-cart|rental-terms|privacy)$ $1/index.html [END]

# Admin routes stay interactive, but get noindex in the initial HTML and header.
RewriteRule ^admin(?:/.*)?$ admin/index.html [END]
AddType text/markdown .md
AddCharset UTF-8 .md

<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/admin(?:/|$)" private_page
  Header always set X-Robots-Tag "noindex, follow" env=private_page
  # Pages vary by Accept (HTML for browsers, Markdown for agents). RFC 8288 Link
  # headers advertise llms.txt and the homepage's Markdown alternate.
  <FilesMatch "\.(?:html|md)$">
    Header append Vary Accept
    Header add Link "</llms.txt>; rel=\"describedby\"; type=\"text/plain\""
  </FilesMatch>
  SetEnvIf Request_URI "^/$" home_page
  Header add Link "</index.md>; rel=\"alternate\"; type=\"text/markdown\"" env=home_page
  # Markdown copies are for agents; keep search results on the HTML pages.
  <FilesMatch "\.md$">
    Header set X-Robots-Tag "noindex, follow"
  </FilesMatch>
  <FilesMatch "\.(?:html|xml|txt|md)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(?:js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Missing URLs must return a real 404 instead of the homepage with a 200 status.
ErrorDocument 404 /404.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]
