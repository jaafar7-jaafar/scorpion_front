# ── Backend API ──────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:5000/api

# ── Google Analytics 4 ───────────────────────────────────────────────────────
# From analytics.google.com > Admin > Data Streams > your web stream
REACT_APP_GA_MEASUREMENT_ID=

# ── Google Ads conversion tracking ──────────────────────────────────────────
# From Google Ads > Tools > Conversions > your account's tag ("AW-XXXXXXXXX")
REACT_APP_GOOGLE_ADS_ID=

# Per-action conversion labels, from each conversion action's "Tag setup" >
# "Use Google Tag Manager" snippet — the part after the slash in send_to.
REACT_APP_GADS_CONVERSION_LABEL_WHATSAPP=
REACT_APP_GADS_CONVERSION_LABEL_BOOKING=
